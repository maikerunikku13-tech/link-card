<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>wakatteTVの過去動画</title>
  <meta name="description" content="画像をクリックして動画を再生できます。">
  <meta property="og:type" content="website">
  <meta property="og:title" content="wakatteTVの過去動画">
  <meta property="og:description" content="画像をクリックして動画を再生できます。">
  <meta property="og:image" content="https://i.ytimg.com/vi/PYMoiNDaCG4/maxresdefault.jpg">
  <meta property="og:image:alt" content="わかってTVと福島大学の画像">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="wakatteTVの過去動画">
  <meta name="twitter:description" content="画像をクリックして動画を再生できます。">
  <meta name="twitter:image" content="https://i.ytimg.com/vi/PYMoiNDaCG4/maxresdefault.jpg">
  <style>
    :root {
      color-scheme: light;
      --page: #111318;
      --text: #333;
      --accent: #ff2d55;
    }

    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 32px 20px;
      color: var(--text);
      background: #f3f3f3;
      font-family: "Yu Gothic", "Hiragino Kaku Gothic ProN", sans-serif;
    }

    .video-link {
      position: relative;
      display: block;
      width: min(100%, 405px);
      overflow: hidden;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      background: #fff;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
      text-decoration: none;
      isolation: isolate;
    }

    .video-link::after {
      content: "";
      position: absolute;
      inset: 0;
      bottom: 48px;
      z-index: 1;
      background: linear-gradient(180deg, transparent 45%, rgba(0, 0, 0, 0.48));
      transition: background 180ms ease;
    }

    .video-link:hover::after,
    .video-link:focus-visible::after {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.58));
    }

    .video-image {
      display: block;
      width: 100%;
      aspect-ratio: 9 / 16;
      object-fit: fill;
      transition: transform 300ms ease;
    }

    .video-link:hover .video-image,
    .video-link:focus-visible .video-image {
      transform: scale(1.03);
    }

    .play-button {
      position: absolute;
      z-index: 2;
      top: 50%;
      left: 50%;
      display: grid;
      width: 82px;
      height: 54px;
      place-items: center;
      border: 1px solid rgba(0, 0, 0, 0.25);
      border-radius: 5px;
      color: white;
      background: rgba(0, 0, 0, 0.48);
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.3);
      transform: translate(-50%, -50%);
      transition: transform 180ms ease, background 180ms ease;
    }

    .play-button::before {
      content: "";
      margin-left: 5px;
      border-top: 16px solid transparent;
      border-bottom: 16px solid transparent;
      border-left: 23px solid currentColor;
    }

    .video-link:hover .play-button,
    .video-link:focus-visible .play-button {
      background: rgba(0, 0, 0, 0.62);
      transform: translate(-50%, -50%) scale(1.08);
    }

    .video-link:focus-visible {
      outline: 3px solid #73d7ff;
      outline-offset: 5px;
    }

    .play-hint {
      position: relative;
      z-index: 2;
      margin: 0;
      padding: 12px 16px;
      color: #606060;
      background: #fff;
      font-size: 0.9rem;
      font-weight: 700;
      text-align: center;
    }
  </style>
</head>
<body>
  <a
    class="video-link"
    href="https://lite.tiktok.com/t/ZS9BnWWek9K7E-AXScN/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="TikTok の動画を再生する（新しいタブで開く）"
  >
    <img
      class="video-image"
      src="https://i.ytimg.com/vi/PYMoiNDaCG4/maxresdefault.jpg"
      alt="わかってTVと福島大学の画像"
    >
    <span class="play-button" aria-hidden="true"></span>
    <p class="play-hint">クリックで動画を再生</p>
  </a>
</body>
</html>
